#!/usr/bin/env bash
# Pre-push hook — release-tag validation across Linux + Windows.
#
# Install (per clone): run scripts/install-hooks.sh.
#
# Do NOT hand-symlink this into .git/hooks — a global `core.hooksPath`
# (git-lfs and most dotfile setups set one) makes git ignore that
# directory entirely, so the hook looks installed and never runs. That
# is how v0.2.7 … v0.2.10 shipped unvalidated. install-hooks.sh points
# core.hooksPath at a repo-local .githooks/ instead, chaining to the
# hooks the clone already inherited.
#
# Triggers ONLY when the push contains a tag matching `refs/tags/v*`
# (release tags), not on regular branch pushes. Mirrors CI's gates so
# a green local validation predicts a green CI run:
#
#   - Linux validator:
#       cargo clippy --all-targets -p claudepot-core -p claudepot-cli -- -D warnings
#     Matches ci.yml's `Format / Clippy (Linux)` job. `--all-targets`
#     is load-bearing: without it, test-only lints accumulate
#     silently between Rust releases (the 2026-05-13 7-lint backlog).
#
#   - Windows validator:
#       cargo test -p claudepot-core -p claudepot-cli --no-run
#     Matches the core+cli compile step of CI's `Tests
#     (windows-latest)` job. Compile only (--no-run): CI re-runs the
#     tests on a fresh matrix anyway, so paying SSH-runtime for a
#     redundant run isn't worth the wall-clock cost. CI's
#     tauri-crate test step is NOT mirrored here — it needs the CLI
#     staged as a Tauri externalBin, which the validator clones
#     don't carry.
#
# Validator hosts are machine-local (internal hostnames — never
# committed). They are read from the gitignored `.validator-hosts`
# file at the repo root, or from the environment:
#
#   CLAUDEPOT_VALIDATOR_LINUX_SSH    e.g. user@linux-host
#   CLAUDEPOT_VALIDATOR_WINDOWS_SSH  e.g. user@windows-host
#
# `.validator-hosts` shape (shell syntax, sourced):
#   CLAUDEPOT_VALIDATOR_LINUX_SSH="user@linux-host"
#   CLAUDEPOT_VALIDATOR_WINDOWS_SSH="user@windows-host"
#
# Real host names live in CLAUDE.local.md. Each validator holds a
# clone of this repo at ~/claudepot-app (Linux) / claudepot-app
# (Windows home) with the origin remote reachable.
#
# Exits non-zero on validation failure; the push is aborted and the
# recovery recipe printed.
#
# ## Fallback when a validator is unreachable
#
# An UNREACHABLE host is not a failure — it is missing evidence, and
# there is a second source for it. CI runs the same two gates
# (`Format / Clippy (Linux)`, `Tests (windows-latest)`) on the same
# commit, so when a host can't be reached the hook asks GitHub whether
# CI is already green for the exact commit being tagged and accepts
# that instead.
#
# This exists because `--no-verify` was becoming the reflex: v0.2.10,
# v0.2.11 and v0.2.12 all shipped that way while the validator boxes
# were offline. A bypass used routinely is indistinguishable from no
# gate at all — which is exactly how these validators sat inert and
# unnoticed for four releases (see scripts/install-hooks.sh).
#
# Note the asymmetry: a host that RUNS THE GATE and fails still aborts.
# Only absence of evidence falls back, never contrary evidence. "Could
# not run the gate" — offline, or online but unable to fetch the commit
# — is absence, and `validate_on` distinguishes the two by exit code.
#
# History: added 2026-05-01 after a four-round CI cascade where each
# fix on macOS-only commits surfaced the next layer of platform-
# conditional bugs. CI fallback added 2026-07-22.
#
# 2026-07-26: fixed two bugs that between them meant this hook had
# never once validated an annotated tag.
#
#   1. It checked out `local_sha`, which for an annotated tag is the
#      TAG OBJECT sha, not the commit. The validator has no copy of
#      that object (the tag is not on origin yet — we are in pre-push),
#      so checkout died with "reference is not a tree". Verified by
#      hand against a validator on 2026-07-26. The hook already
#      dereferenced `^{commit}` for the CI lookup and documented why;
#      it just never used that value for the checkout.
#   2. Sync and gate shared one ssh command, so a host that could not
#      reach GitHub reported "clippy failed" — contrary evidence the
#      hook had not actually gathered. That aborted the v0.3.1 and
#      v0.3.2 tag pushes; both then shipped under `--no-verify`.
#
# Bug 1 made the gate unpassable and bug 2 made its failure look real,
# so the bypass looked like the only way through. Treat a run of
# `--no-verify` releases as evidence this hook is broken, not as
# evidence the validators are merely offline.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
if [ -f "$repo_root/.validator-hosts" ]; then
  # shellcheck source=/dev/null
  . "$repo_root/.validator-hosts"
fi

# Is this host answering right now? BatchMode so a missing key fails
# fast instead of prompting into a hook with no usable tty.
host_reachable() {
  ssh -o ConnectTimeout=8 -o BatchMode=yes "$1" true >/dev/null 2>&1
}

# Has CI already gone green for this exact COMMIT?
#
# `$1` must be a commit sha, not a tag sha — an annotated tag's own
# object hashes differently from the commit it points at, so looking up
# the tag sha would silently never match. Callers dereference with
# `^{commit}` before calling.
ci_green_for_commit() {
  command -v gh >/dev/null 2>&1 || return 1
  gh run list --commit "$1" --workflow ci.yml --limit 1 \
    --json status,conclusion \
    --jq 'first | select(.status == "completed" and .conclusion == "success")' \
    2>/dev/null | grep -q .
}

# Run one platform gate on a validator host.
#
#   $1 host   $2 remote workdir   $3 COMMIT sha   $4 gate command
#
# Exit codes are the whole point — they encode the asymmetry this hook
# depends on:
#
#   0 — the gate ran and passed
#   1 — the gate ran and FAILED (contrary evidence: abort the release)
#   2 — the host could not be used at all (absence of evidence: defer)
#
# Sync is a SEPARATE ssh call from the gate, deliberately. Folded into
# one `git fetch && git checkout && cargo ...` command, a host with no
# route to GitHub fails at `fetch` and the hook reports it as "clippy
# failed" — contrary evidence that was never gathered. That misreport
# aborted the v0.3.1 and v0.3.2 tag pushes and sent both out under
# `--no-verify`, which is exactly the reflex this hook exists to stop.
validate_on() {
  _host="$1"; _dir="$2"; _commit="$3"; _gate="$4"
  host_reachable "$_host" || return 2
  # `$_commit` must be the COMMIT sha, never the pushed `local_sha`: for
  # an annotated tag those differ, the validator has no copy of the tag
  # object (the tag is not on origin yet — we are in pre-push), and
  # `git checkout <tag-object-sha>` fails with "reference is not a
  # tree". That made every annotated-tag validation abort regardless of
  # the code being pushed.
  # shellcheck disable=SC2029  # $_commit must expand client-side
  ssh "$_host" "cd $_dir && git fetch --quiet && git checkout --quiet --detach $_commit" \
    >/dev/null 2>&1 || return 2
  # shellcheck disable=SC2029  # $_gate must expand client-side
  ssh "$_host" "cd $_dir && $_gate" || return 1
  return 0
}

# git feeds the ref list on stdin, and stdin can only be drained once.
# Both the secret guard and the release validator below need it, so
# buffer it here and feed each from the buffer.
push_payload="$(cat)"

# ─── Secret guard — runs on EVERY push, not just release tags ────────
#
# On 2026-07-26 two validator hostnames reached the public repo inside
# a generated config, and sat in 18 commit MESSAGES as well as in file
# contents. Scrubbing them cost a full history rewrite and a force-push
# across 44 tags. This blocks the next one at the last moment it is
# still cheap.
#
# The blocklist is NEVER hardcoded here — this file is public. It is
# derived from the gitignored files that legitimately hold the real
# values:
#
#   .secret-patterns   one extended-regex per line, `#` comments ok
#   .validator-hosts   fallback: the host part of each user@host
#
# No patterns configured means no check. That is deliberate: a fresh
# clone with no local secrets has nothing to leak, and a hook that
# fails closed on absent config would just teach --no-verify.
secret_patterns_file="$repo_root/.secret-patterns"
guard_patterns=""

if [ -f "$secret_patterns_file" ]; then
  guard_patterns="$(grep -vE '^\s*(#|$)' "$secret_patterns_file" || true)"
elif [ -n "${CLAUDEPOT_VALIDATOR_LINUX_SSH:-}${CLAUDEPOT_VALIDATOR_WINDOWS_SSH:-}" ]; then
  guard_patterns="$(
    for _h in "${CLAUDEPOT_VALIDATOR_LINUX_SSH:-}" "${CLAUDEPOT_VALIDATOR_WINDOWS_SSH:-}"; do
      [ -n "$_h" ] && printf '%s\n' "${_h#*@}"
    done | sort -u
  )"
fi

if [ -n "$guard_patterns" ]; then
  guard_re="$(printf '%s' "$guard_patterns" | paste -sd'|' -)"
  guard_hit=0

  while read -r _lref local_sha _rref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    # Deleting a ref pushes no content.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac

    # New ref on the remote: bound the scan by what the remote already
    # has, so creating a branch doesn't rescan all of history.
    case "$remote_sha" in
      *[!0]*) range="$remote_sha..$local_sha" ;;
      *)      range="$local_sha --not --remotes=origin" ;;
    esac

    # Only ADDED lines count. Scanning the whole diff would also match the
    # deletion of a leaked value, which would block the very commit that
    # removes it — and `+++ b/path` headers, which are not content.
    # shellcheck disable=SC2086  # $range is intentionally word-split
    if git log -p --no-color $range 2>/dev/null \
         | grep -E '^\+' | grep -vE '^\+\+\+' \
         | grep -nEi -- "$guard_re" >/dev/null; then
      echo "✗ Push blocked: a pushed commit's CONTENT matches a local secret pattern."
      guard_hit=1
    fi
    # shellcheck disable=SC2086
    if git log --format='%B' --no-color $range 2>/dev/null | grep -nEi -- "$guard_re" >/dev/null; then
      echo "✗ Push blocked: a pushed commit MESSAGE matches a local secret pattern."
      echo "  Message text cannot be fixed by editing a file — it needs a rebase"
      echo "  (git rebase -i --exec 'git commit --amend') or filter-repo."
      guard_hit=1
    fi
  done <<EOF
$push_payload
EOF

  if [ "$guard_hit" -ne 0 ]; then
    echo
    echo "  Patterns come from .secret-patterns (or .validator-hosts) —"
    echo "  both gitignored. Nothing is printed here on purpose: echoing"
    echo "  the match into a terminal log would defeat the point."
    echo
    echo "  Find it with:   git log -p @{u}..HEAD | grep -E '^\\+' | grep -nEi -f .secret-patterns"
    echo "  Then replace the value with a placeholder and amend/rebase."
    echo
    echo "  Bypass with --no-verify ONLY if you are certain the match is"
    echo "  a false positive. This repo is PUBLIC; a bad push is not"
    echo "  retractable — forks keep whatever they cloned."
    exit 1
  fi
fi

# git's pre-push protocol feeds four positional fields per ref; we only
# consult two of them, but all four must be named to parse the line.
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/v*) ;;          # tag push — validate
    *) continue ;;            # any other ref — skip
  esac

  tag_name="${remote_ref#refs/tags/}"

  if [ -z "${CLAUDEPOT_VALIDATOR_LINUX_SSH:-}" ] || [ -z "${CLAUDEPOT_VALIDATOR_WINDOWS_SSH:-}" ]; then
    echo "✗ Release tag push ($tag_name) but validator hosts are not configured."
    echo
    echo "  Create .validator-hosts at the repo root (gitignored):"
    echo "    CLAUDEPOT_VALIDATOR_LINUX_SSH=\"user@linux-host\""
    echo "    CLAUDEPOT_VALIDATOR_WINDOWS_SSH=\"user@windows-host\""
    echo
    echo "  Real host names live in CLAUDE.local.md. Bypass with"
    echo "  'git push --no-verify' if the validators are unreachable."
    exit 1
  fi

  # An annotated tag's own object sha is NOT the commit sha; CI indexes
  # runs by commit, so dereference before any lookup.
  commit_sha="$(git rev-parse "${local_sha}^{commit}")"

  echo "Release tag push detected ($remote_ref → $commit_sha)"
  echo "──────────────────────────────────────────────────────"

  skipped=""

  # Linux validation — mirrors CI's `Format / Clippy (Linux)` job.
  echo "▶ Linux clippy on $CLAUDEPOT_VALIDATOR_LINUX_SSH ..."
  # Relative path: ssh lands in $HOME, so this resolves to
  # ~/claudepot-app without a tilde that shellcheck (rightly) flags as
  # non-expanding in quotes. Matches the Windows call below.
  validate_on "$CLAUDEPOT_VALIDATOR_LINUX_SSH" "claudepot-app" "$commit_sha" \
    "cargo clippy --all-targets -p claudepot-core -p claudepot-cli -- -D warnings" \
    && linux_rc=0 || linux_rc=$?
  case "$linux_rc" in
    0) echo "✓ Linux clippy clean" ;;
    2)
      echo "• Linux validator unusable (offline, or cannot reach GitHub to"
      echo "  sync $commit_sha) — deferring to CI"
      skipped="Linux"
      ;;
    *)
      echo
      echo "✗ Linux clippy failed on $commit_sha. Release aborted."
      echo
      echo "  The gate ran and reported a real lint failure — this is not"
      echo "  a connectivity problem (that path defers to CI instead)."
      echo
      echo "Recovery:"
      echo "  1. Fix the lint locally"
      echo "  2. git tag -d $tag_name"
      echo "  3. Re-tag the new commit"
      echo "  4. Re-push"
      exit 1
      ;;
  esac
  echo

  # Windows validation (MSVC toolchain — matches the CI runner).
  echo "▶ Windows test compile on $CLAUDEPOT_VALIDATOR_WINDOWS_SSH ..."
  validate_on "$CLAUDEPOT_VALIDATOR_WINDOWS_SSH" "claudepot-app" "$commit_sha" \
    "cargo test -p claudepot-core -p claudepot-cli --no-run" \
    && win_rc=0 || win_rc=$?
  case "$win_rc" in
    0) echo "✓ Windows test compile clean" ;;
    2)
      echo "• Windows validator unusable (offline, or cannot reach GitHub"
      echo "  to sync $commit_sha) — deferring to CI"
      skipped="${skipped:+$skipped + }Windows"
      ;;
    *)
      echo
      echo "✗ Windows test compile failed on $commit_sha. Release aborted."
      echo
      echo "  The gate ran and reported a real build failure — this is not"
      echo "  a connectivity problem (that path defers to CI instead)."
      echo
      echo "Recovery:"
      echo "  1. Fix the build error locally (likely a missing cfg gate)"
      echo "  2. git tag -d $tag_name"
      echo "  3. Re-tag the new commit"
      echo "  4. Re-push"
      exit 1
      ;;
  esac
  echo

  # Nothing was skipped → both hosts answered and both passed.
  if [ -n "$skipped" ]; then
    echo "▶ $skipped validator(s) unreachable; checking CI for $commit_sha ..."
    if ci_green_for_commit "$commit_sha"; then
      echo "✓ CI is green for this commit — accepting in place of $skipped"
    else
      echo
      echo "✗ $skipped validator(s) unreachable AND no green CI run for"
      echo "  $commit_sha. Nothing has verified this commit on that"
      echo "  platform, so the release is aborted."
      echo
      echo "Recovery — pick one:"
      echo "  a. Push the branch first and let CI finish, then re-push the tag"
      echo "  b. Bring the validator host back online and re-push the tag"
      echo "  c. git push --no-verify   (records NO verification — say so"
      echo "     in the release notes if you take this route)"
      echo
      echo "  If CI did run, check 'gh auth status' — the lookup needs an"
      echo "  authenticated gh, and treats an unauthenticated one as 'no run'."
      exit 1
    fi
    echo
  fi

  echo "──────────────────────────────────────────────────────"
  if [ -n "$skipped" ]; then
    echo "✓ Release validation passed (CI stood in for $skipped)."
  else
    echo "✓ Release validation passed across Linux + Windows."
  fi
done <<EOF
$push_payload
EOF

exit 0
